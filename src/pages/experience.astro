---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Experience | Engineering Portfolio" description="Education, teaching and engineering experience.">
  <Header />
  <main class="section-wrap inner-page">
    <div class="page-intro">
      <p class="eyebrow">BACKGROUND</p>
      <h1>Education &amp; <span>experience.</span></h1>
      <p>Academic training, teaching, and hands-on engineering work. This page will be updated as additional professional experience is completed.</p>
    </div>

    <section class="timeline-section">
      <p class="eyebrow">EDUCATION</p>
      <article class="timeline-item">
        <div class="timeline-date">2025 — 2030 (expected)</div>
        <div>
          <h2>University of Waterloo</h2>
          <p class="role-line">Bachelor of Computer Science</p>
          <p>Coursework and independent study focused on computer systems, algorithms, operating systems and software engineering.</p>
          <div class="tag-row"><span>Computer Science</span><span>Systems</span><span>Algorithms</span></div>
        </div>
      </article>
    </section>

    <section class="timeline-section">
      <p class="eyebrow">TEACHING</p>
      <article class="timeline-item">
        <div class="timeline-date">September 2026 — Present</div>
        <div>
          <h2>CS 137 Instructional Assistant</h2>
          <p class="role-line">University of Waterloo</p>
          <p>Support students learning foundational programming in C, including pointers, dynamic memory, recursion, data structures, sorting, algorithmic complexity and debugging.</p>
          <div class="tag-row"><span>C</span><span>Debugging</span><span>Data Structures</span><span>Programming Fundamentals</span></div>
        </div>
      </article>
    </section>

    <section class="timeline-section">
      <p class="eyebrow">ENGINEERING EXPERIENCE</p>
      <article class="timeline-item">
        <div class="timeline-date">2026 — Present</div>
        <div>
          <h2>Independent Systems &amp; Embedded Projects</h2>
          <p class="role-line">Project-based engineering</p>
          <p>Design and implementation work across a bare-metal AArch64 RTOS, Linux PCIe DMA driver and C++ runtime, STM32 sensor firmware, and a ROS 2 autonomous-car architecture.</p>
          <a class="text-link" href="/projects">Explore project details ↗</a>
        </div>
      </article>
    </section>

    <section class="timeline-section">
      <p class="eyebrow">INTERNSHIP EXPERIENCE</p>
      <article class="timeline-item">
        <div class="timeline-date">To be updated</div>
        <div>
          <h2>Internship &amp; industry roles</h2>
          <p>Professional internship experience will be listed here once a role has been confirmed. The portfolio does not currently claim an internship that has not yet taken place.</p>
        </div>
      </article>
    </section>
  </main>
  <Footer />
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const focusAreas = [
  { number: "01", title: "Operating Systems", text: "Bare-metal AArch64, scheduling, interrupts, synchronization and multicore experiments." },
  { number: "02", title: "System Software", text: "Linux device drivers, PCIe DMA, user-space runtimes, queues and profiling." },
  { number: "03", title: "Autonomous Robotics", text: "ROS 2, multi-sensor fusion, localization, motion planning and real-time control." },
  { number: "04", title: "Embedded Systems", text: "STM32 firmware, sensor acquisition, motor interfaces and real-time data pipelines." }
];

const projects = [
  {
    tag: "OPERATING SYSTEMS",
    title: "AArch64 RTOS",
    description: "A bare-metal AArch64 real-time OS on QEMU virt, exploring exception levels, GIC interrupts, preemptive scheduling and SMP bring-up.",
    stack: "C · AArch64 · QEMU · GIC · Scheduler",
    href: "https://github.com/Lengfeng88/aarch64-rtos",
    status: "Active development"
  },
  {
    tag: "SYSTEM SOFTWARE",
    title: "Accelerator Systems Stack",
    description: "A Linux PCIe DMA driver and C++ runtime for command submission, completion queues, buffer management, synchronization and profiling.",
    stack: "C · C++ · Linux · PCIe · DMA",
    href: "https://github.com/Lengfeng88/accel-systems-stack",
    status: "Implementation and validation"
  },
  {
    tag: "AUTONOMOUS ROBOTICS",
    title: "ROS 2 Autonomous Car",
    description: "A differential-drive vehicle project focused on real-time multi-sensor fusion, localization and autonomous navigation.",
    stack: "ROS 2 · C++ · IMU · Encoders · LiDAR",
    href: "/projects#autonomous-car",
    status: "Architecture and build phase"
  },
  {
    tag: "EMBEDDED SYSTEMS",
    title: "Real-Time Sensor Platform",
    description: "An STM32H743 sensor pipeline connected to a Raspberry Pi 5 user-space client, emphasizing packet integrity and timing.",
    stack: "STM32 · C/C++ · I²C · UART · Raspberry Pi",
    href: "/projects#sensor-platform",
    status: "In progress"
  }
];
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero section-wrap">
      <div class="hero-copy">
        <p class="eyebrow"><span class="pulse"></span> SYSTEMS · EMBEDDED · AUTONOMOUS ROBOTICS</p>
        <h1>Building software<br /><span>closer to the hardware.</span></h1>
        <p class="hero-lede">
          I build and investigate software systems spanning operating systems,
          embedded platforms, system software and autonomous robotics — with an
          emphasis on understanding, measuring and validating how software interacts with hardware.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/projects">Explore projects <span>↗</span></a>
          <a class="button button-secondary" href="https://github.com/Lengfeng88" target="_blank" rel="noreferrer">View GitHub</a>
        </div>
        <div class="hero-meta">
          <span><i></i> C / C++ / Python</span>
          <span><i></i> Linux &amp; RTOS</span>
          <span><i></i> ROS 2 &amp; Embedded</span>
        </div>
      </div>
      <div class="hero-visual" aria-label="Layered hardware and software architecture illustration">
        <div class="visual-top"><span>ENGINEERING STACK / 01</span><span>HARDWARE-AWARE</span></div>
        <div class="stack-layer layer-1"><b>APPLICATION</b><small>Autonomy · Workloads · Control</small></div>
        <div class="stack-connector"></div>
        <div class="stack-layer layer-2"><b>RUNTIME &amp; MIDDLEWARE</b><small>ROS 2 · Queues · Scheduling</small></div>
        <div class="stack-connector"></div>
        <div class="stack-layer layer-3"><b>OS / DRIVER / FIRMWARE</b><small>Linux · RTOS · Interrupts · DMA</small></div>
        <div class="stack-connector"></div>
        <div class="stack-layer layer-4"><b>HARDWARE</b><small>CPU · MCU · Motors · Sensors</small></div>
        <div class="visual-bottom"><span>SOFTWARE ↔ HARDWARE INTEGRATION</span><span>↘</span></div>
      </div>
    </section>

    <section class="focus-section section-wrap">
      <div class="section-heading">
        <div><p class="eyebrow">TECHNICAL FOCUS</p><h2>Four connected domains.</h2></div>
        <p class="section-note">From low-level execution to autonomous systems.</p>
      </div>
      <div class="focus-grid">
        {focusAreas.map((item) => (
          <article class="focus-card">
            <span class="card-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="projects-section section-wrap">
      <div class="section-heading">
        <div><p class="eyebrow">SELECTED WORK</p><h2>Projects in focus.</h2></div>
        <a class="text-link" href="/projects">All projects <span>→</span></a>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <article class="project-card">
            <div class="project-card-top"><span class="project-tag">{project.tag}</span><span class="project-index">0{index + 1}</span></div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="project-stack">{project.stack}</div>
            <div class="project-card-bottom">
              <span class="status"><i></i>{project.status}</span>
              <a href={project.href} target={project.href.startsWith("http") ? "_blank" : undefined} rel={project.href.startsWith("http") ? "noreferrer" : undefined} aria-label={`View ${project.title}`}>↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="closing section-wrap">
      <div><p class="eyebrow">ENGINEERING NOTES</p><h2>Design decisions.<br />Measured results.</h2></div>
      <a class="button button-primary" href="/deep-dives">Read technical deep dives ↗</a>
    </section>
  </main>
  <Footer />
</BaseLayout>
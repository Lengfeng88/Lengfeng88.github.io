---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Engineering Portfolio | Lengfeng88",
  description = "Operating systems, embedded systems, autonomous robotics and system software."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
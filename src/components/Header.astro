---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/deep-dives", label: "Technical Deep Dives" },
  { href: "/experience", label: "Experience" },
  { href: "/about", label: "About" }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Portfolio home">
    <span class="brand-primary">Brandon Xu</span>
    <span class="brand-subtitle">ENGINEERING PORTFOLIO</span>
  </a>
  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a class:list={["nav-link", path === link.href ? "active" : ""]} href={link.href}>{link.label}</a>
    ))}
    <a class="nav-github" href="https://github.com/Lengfeng88" target="_blank" rel="noreferrer">GitHub ↗</a>
  </nav>
</header>
